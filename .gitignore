__pycache__/
*.pyc
*.egg-info/
build/
dist/
.sync-conflict-*

# Generated API reference: built by CI and published to Pages, never committed --
# a checked-in copy drifts from the docstrings it was generated from.
docs/api/

# coverage output
.coverage
.coverage.*

# Saved embeddings: the store writes here, and a walk now writes one file per configuration as it
# runs. They are rebuildable from the recipe each one carries, and 288 npz files landing inside the
# committed cache is not a cache, it is a working directory. .gitkeep keeps the directory itself.
starplast/data/embeddings/*
!starplast/data/embeddings/.gitkeep
