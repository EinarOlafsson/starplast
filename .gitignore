__pycache__/
*.pyc
*.egg-info/
build/
dist/
.sync-conflict-*

# Generated API reference: built by CI and published to Pages, never committed --
# a checked-in copy drifts from the docstrings it was generated from.
docs/api/

# coverage output
.coverage
.coverage.*

# Saved embeddings: the store writes here, and a walk now writes one file per configuration as it
# runs. They are rebuildable from the recipe each one carries, and 288 npz files landing inside the
# committed cache is not a cache, it is a working directory. .gitkeep keeps the directory itself.
starplast/data/embeddings/*
!starplast/data/embeddings/.gitkeep

# Analysis-run embeddings: the CSVs are the record, the npz files are rebuildable from the
# recipe each one carries, and a results directory is not a place to ship 67 MB of them.
results/*/embeddings/
results/*/run.log

# Downloaded datasets. Gigabytes of GEO and PRIDE archives, and not one of them is source: they are
# fetched by scripts/fetch_candidates.py from accessions recorded in the slot tables, so the
# accession is the thing worth versioning and the tarball is not. A 200 MB archive committed here
# also cannot be pushed at all -- GitHub refuses anything over 100 MB -- so this is the difference
# between a repository that clones and one that does not.
datasets/

# local build inputs: these trees live outside the repo in this checkout
toxonet
toxo_stage_atlas
starpath_interactions.csv
starpath_crosslinks.json
starpath_crosslink_mining
starpath_dump
.claude
