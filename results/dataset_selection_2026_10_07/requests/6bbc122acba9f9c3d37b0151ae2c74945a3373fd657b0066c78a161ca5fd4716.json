            "journalIssueId": 2989423,
            "dateOfPublication": "2020 Sep",
            "monthOfPublication": 9,
            "yearOfPublication": 2020,
            "journal": {
              "medlineAbbreviation": "Cell Microbiol",
              "title": "Cellular microbiology",
              "essn": "1462-5822",
