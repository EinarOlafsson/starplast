pe":"ORCID","value":"0000-0003-3838-8664"},{"type":"ORCID","value":"0000-0003-4204-8734"},{"type":"ORCID","value":"0000-0003-4585-1581"},{"type":"ORCID","value":"0009-0003-3680-6305"}]},"dataLinksTagsList":{"dataLinkstag":["altmetrics","supporting_data"]},"journalInfo":{"issue":"6509","volume":"369","journalIssueId":3010024,"dateOfPublication":"2020 Sep","monthOfPublication":9,"yearOfPublication":2020,"journal":{"medlineAbbreviation":"Science","title":"Science (New York, N.Y.)","essn":"1095-9203","issn":"0036-8075","nlmid":"0404511","isoabbreviation":"Science"},"printPublicationDate":"2020-09-01"},"pubYear":"2020","pageInfo":"1318-1330","abstractText":"The Genotype-Tissue Expression (GTEx) project was established to characterize genetic effects on the transcriptome across human tissues and to link these regulatory mechanisms to trait and disease associations. Here, we present analyses of the version 8 data, examining 15,201 RNA-sequencing samples from 49 tissues of 838 postmortem donors. We comprehensively characterize genetic associations for gene expression and splicing in cis and trans, showing that regulatory associations are found for almost all genes, and describe the underlying molecular mechanisms and their contribution to allelic heterogeneity and pleiotropy of complex traits. Leveraging the large diversity of tissues, we provide insights into the tissue specificity of genetic effects and show that cell type composition is a key factor in understanding gene regulatory mechanisms in human tissues.","publicationStatus":"ppublish","language":"eng","pubModel":"Print","pubTypeList":{"pubType":["Research Support, Non-U.S. Gov't","research-article","Journal Article","Research Support, N.I.H., Extramural"]},"grantsList":{"grant":[{"agency":"CCR NIH HHS","acronym":"RC","grantId":"HHSN261200800001C","orderIn":0},{"agency":"NHGRI NIH HHS","acronym":"HG","grantId":"K99 HG009916","orderIn":0},{"agency":"NIDDK NIH HHS","acronym":"DK","grantId":"P30 DK020595","orderIn":0}